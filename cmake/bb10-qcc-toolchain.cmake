set(CMAKE_SYSTEM_NAME QNX)
set(CMAKE_SYSTEM_PROCESSOR arm)

if(NOT DEFINED ENV{QNX_HOST})
  message(FATAL_ERROR "QNX_HOST is not set")
endif()

if(NOT DEFINED ENV{QNX_TARGET})
  message(FATAL_ERROR "QNX_TARGET is not set")
endif()

set(QNX_HOST "$ENV{QNX_HOST}")
set(QNX_TARGET "$ENV{QNX_TARGET}")

set(CMAKE_C_COMPILER qcc)
set(CMAKE_CXX_COMPILER qcc)

set(CMAKE_C_FLAGS_INIT "-Vgcc_ntoarmv7le")
set(CMAKE_CXX_FLAGS_INIT "-Vgcc_ntoarmv7le -lang-c++")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Vgcc_ntoarmv7le")

set(CMAKE_FIND_ROOT_PATH "${QNX_TARGET}" "${QNX_HOST}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/arm/o.le-v7-g")
